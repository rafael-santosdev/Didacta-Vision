# Didacta-Vision — Exemplo de variáveis para produção (copie para .env)
# Obrigatório: DEBUG=False, SECRET_KEY forte, ALLOWED_HOSTS com domínio e/ou IP da VM

DEBUG=False
SECRET_KEY=altere-para-uma-chave-secreta-longa-e-aleatoria
# Acesso por IP (Compute Engine): inclua o IP público, ex. 34.123.45.67
ALLOWED_HOSTS=localhost,127.0.0.1,34.123.45.67

# HTTPS (Cloud Run, App Engine, etc.): inclua a origem exata sem barra no final
CSRF_TRUSTED_ORIGINS=https://xxx.run.app,https://seudominio.com.br

# GCloud Cloud Run usa PORT=8080 (o entrypoint já lê PORT)
# PORT=8080

# Banco: padrão é SQLite (volume no compose)
SQLITE_DB_PATH=/app/db/db.sqlite3

# Opcional — MySQL (use só se DB_USE_MYSQL=True)
# DB_USE_MYSQL=True
# DB_NAME=didacta_vision
# DB_USER=didacta
# DB_PASSWORD=sua_senha
# DB_HOST=db
# DB_PORT=3306

# E-mail (opcional; sem isso o sistema usa código temporário na tela)
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_MAILGUN_API_KEY=
# EMAIL_MAILGUN_DOMAIN=
